      "id": "433a6afc-f7cc-4dc3-9e41-d4c88c68b325",
      "name": "Fetch PR files",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1104,
        224
      ],
      "credentials": {
        "httpBearerAuth": {
          "id": "abiuQLjD30spVM6O",
          "name": "GitHub ITMO"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const ctx=$('Preserve PR SHA').first().json;\nlet files=$input.all().map(i=>i.json);if(files.length===1&&Array.isArray(files[0]))files=files[0];\nconst hunks=[];let idx=0;\nfor(const f of files){let patch=f.patch||'';if(!patch)continue;\n  const pieces=patch.split(/(?=^@@\\s)/m).filter(s=>s.startsWith('@@'));\n  for(const part of pieces){const m=part.match(/^@@ -(\\d+)(?:,(\\d+))? \\+(\\d+)(?:,(\\d+))? @@/);if(!m)continue;\n    let oldLine=+m[1],newLine=+m[3],anchor=null,side='RIGHT';\n    for(const line of part.split('\\n').slice(1)){\n      if(line.startsWith('+')&&!line.startsWith('+++')){if(anchor===null){anchor=newLine;side='RIGHT'}newLine++}\n      else if(line.startsWith('-')&&!line.startsWith('---')){if(anchor===null){anchor=oldLine;side='LEFT'}oldLine++}\n      else if(!line.startsWith('\\\\')){oldLine++;newLine++}\n    }\n    if(anchor===null)continue;\n    hunks.push({id:++idx,path:f.filename,line:anchor,side,patch:part.slice(0,2400)});\n  }\n}\nif(!hunks.length)throw new Error('No GitHub patches/hunks available; add a small text-file change to PR');\nreturn [{json:{...ctx,hunks,prompt:JSON.stringify(hunks).slice(0,24000)}}];"
      },
      "id": "6a3ce65c-b073-4257-82a0-e141c11287cf",
      "name": "Prepare diff hunks",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1328,
        224
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.vsellm.ru/v1/chat/completions",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpBearerAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({model: $(\"Prepare diff hunks\").first().json.other ? \"openai/gpt-4.1-mini\" : \"openai/gpt-4o-mini\",temperature:0.1,messages:[{role:\"system\",content:\"Return valid JSON only, no markdown.\"},{role:\"user\",content:\"Review diff. Output {summary:string, comments:[{id:number,body:string}]}. Exactly one useful comment for EACH hunk id. No fabricated bugs. Hunks: \"+$(\"Prepare diff hunks\").first().json.prompt}]}) }}",
        "options": {
          "timeout": 120000
        }
      },
      "id": "e2ea5fc3-4540-4ca7-ad99-988fb1682919",
      "name": "AI review · two models",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1552,
        224
      ],
      "credentials": {
        "httpBearerAuth": {
          "id": "WCNCupLrLEmH195m",
          "name": "VseLLM ITMO"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const ctx=$('Prepare diff hunks').first().json;let raw=$input.first().json.choices?.[0]?.message?.content||'';\nraw=String(raw).replace(/^```(?:json)?\\s*/,'').replace(/```\\s*$/,'');let obj={};\ntry{obj=JSON.parse(raw)}catch{throw new Error('Model must return JSON: '+raw.slice(0,400))}\nconst byId=new Map((Array.isArray(obj.comments)?obj.comments:[]).map(c=>[Number(c.id),String(c.body||'')]));\nconst comments=ctx.hunks.map(h=>({...h,body:(byId.get(h.id)||'AI reviewed this diff hunk; no clear defect found.').slice(0,5000)}));\nconst summary=String(obj.summary||'Reviewed changed hunks.').slice(0,8000);\nconst comment_body='**AI code review ('+(ctx.other?'second model':'primary model')+')**\\n\\n'+summary+'\\n\\nInline comments: '+comments.length;\nreturn [{json:{...ctx,comment_body,comments}}];"
      },

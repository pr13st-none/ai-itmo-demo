    {
      "parameters": {
        "jsCode": "const ev=$input.first().json;const b=ev.body||ev;const action=b.action||'';\nconst comment=String(b.comment?.body||'').trim();\nconst isPr=action==='opened'&&!!b.pull_request;\nconst isCmd=action==='created'&&!!b.issue?.pull_request&&['/make_ai_review','/make_other_ai_review'].includes(comment);\nconst valid=!!(isPr||isCmd)&&!!b.repository?.full_name;\nconst pr=isPr?b.pull_request:b.issue;\nconst number=pr?.number||b.number;\nconst repo=b.repository?.full_name||'';\nconst other=comment==='/make_other_ai_review';\nconst pr_key=repo+'#'+number;\nreturn [{json:{valid,pr_key,repo,number,other,primary:!other,trigger:comment||action,source_action:action}}];"
      },

      "parameters": {
        "url": "={{ \"https://api.github.com/repos/\"+$(\"Preserve PR SHA\").first().json.repo+\"/pulls/\"+$(\"Preserve PR SHA\").first().json.number+\"/files?per_page=100\" }}",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpBearerAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "User-Agent",

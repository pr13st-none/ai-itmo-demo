      "id": "996d4058-1b7a-4aa9-8763-a84e401ed3a8",
      "name": "Previous week row",
      "type": "n8n-nodes-base.dataTable",
      "typeVersion": 1.1,
      "position": [
        1728,
        0
      ],
      "alwaysOutputData": true
    },
    {
      "parameters": {
        "jsCode": "const s=$('Group weekly stats').first().json;let previous={total:0,types:{},authors:{},states:{}};const row=$input.first().json;\ntry{if(row.summary)previous=JSON.parse(row.summary)}catch{}\nconst delta={total:s.total-(previous.total||0),types:{}};for(const k of Object.keys(s.types))delta.types[k]=s.types[k]-(previous.types?.[k]||0);\nreturn [{json:{...s,previous,delta}}];"
      },
      "id": "ffa16392-2608-4453-97af-6930bb558230",
      "name": "Calculate delta",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1952,
        0
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.vsellm.ru/v1/chat/completions",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpBearerAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({model:\"openai/gpt-4o-mini\",temperature:0.2,messages:[{role:\"system\",content:\"Write only 2-3 concise Russian sentences with factual observations, no JSON.\"},{role:\"user\",content:\"Comment on this weekly statistics and week-over-week delta without inventing causes: \"+JSON.stringify($json)}]}) }}",
        "options": {
          "timeout": 120000
        }
      },
      "id": "42f5509c-b01a-41cb-b5a3-73cfd0c6876a",
      "name": "AI weekly annotation",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        2160,
        0
      ],
      "credentials": {
        "httpBearerAuth": {
          "id": "WCNCupLrLEmH195m",
          "name": "VseLLM ITMO"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const s=$('Calculate delta').first().json;let ai=String($input.first().json.choices?.[0]?.message?.content||'').slice(0,3000);\nconst escape=t=>String(t).replace(/[&<>\"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','\"':'&quot;',\"'\":'&#39;'}[c]));\nconst rows=Object.entries(s.types).map(([t,n])=>'<tr><td>'+escape(t)+'</td><td>'+n+'</td><td>'+((s.delta.types[t]>0?'+':'')+s.delta.types[t])+'</td></tr>').join('');\nconst auth=Object.entries(s.authors).sort((a,b)=>b[1]-a[1]).map(([a,n])=>'<tr><td>'+escape(a)+'</td><td>'+n+'</td></tr>').join('')||'<tr><td colspan=\"2\">Нет новых Issues</td></tr>';\nconst html='<html><body style=\"font-family:Arial,sans-serif;max-width:680px;margin:28px auto;color:#222\"><h1>GitHub Issues — недельный отчёт</h1><p>Неделя: '+s.week+'</p><p><b>Новых Issues: '+s.total+' (Δ '+(s.delta.total>0?'+':'')+s.delta.total+')</b></p><h2>По типам</h2><table border=\"1\" cellspacing=\"0\" cellpadding=\"8\"><tr><th>Тип</th><th>Всего</th><th>Δ</th></tr>'+rows+'</table><h2>По авторам</h2><table border=\"1\" cellspacing=\"0\" cellpadding=\"8\"><tr><th>Автор</th><th>Issues</th></tr>'+auth+'</table><p>Открытых: '+s.states.open+' · Закрытых: '+s.states.closed+'</p><h2>AI-комментарий недели</h2><p>'+escape(ai)+'</p></body></html>';\nreturn [{json:{...s,ai,html,summary:JSON.stringify({total:s.total,types:s.types,authors:s.authors,states:s.states})}}];"
      },

    {
      "parameters": {
        "jsCode": "const bounds=$('Week bounds').first().json;\nconst items=$(\"GH 1 issues updated\").all().map(i=>i.json).flatMap(j=>Array.isArray(j)?j:[j]);\nconst issues=items.filter(j=>j?.number&&!j.pull_request&&new Date(j.created_at)>=new Date(bounds.start)&&new Date(j.created_at)<new Date(bounds.end));\nconst types={bug:0,task:0,feature:0,'needs-triage':0,other:0},authors={},states={open:0,closed:0};\nfor(const it of issues){const ty=it.labels?.map(x=>typeof x==='string'?x:x.name).find(x=>['bug','task','feature','needs-triage'].includes(x))||'other';types[ty]++;authors[it.user?.login||'unknown']=(authors[it.user?.login||'unknown']||0)+1;states[it.state==='closed'?'closed':'open']++;}\nconst count=(name)=>$(name).all().map(i=>i.json).flatMap(j=>Array.isArray(j)?j:[j]).filter(j=>j?.id).length;\nreturn [{json:{...bounds,total:issues.length,types,authors,states,closed_events:count('GH 2 closed issues'),comments:count('GH 3 issue comments'),prs:count('GH 4 pull requests')}}];"
      },
      "id": "4149fcf0-6ad3-4d0f-b83b-be037943205a",
      "name": "Group weekly stats",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1488,
